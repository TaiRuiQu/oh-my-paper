DATABASE_URL=postgresql://oh_my_paper:REPLACE_ME@127.0.0.1:5432/oh_my_paper
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# AI provider keys are encrypted with this persistent secret.
PROVIDER_KEY_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
STORAGE_ROOT=./storage
TEMP_ROOT=./tmp
# Optional: defaults to .venv/bin/python if present, otherwise python3.
# CARD_SCAN_PYTHON=/path/to/python
# Docker Compose deployment (not used by a local pnpm dev server):
# APP_DOMAIN=paper.example.com
# POSTGRES_USER=paper
# POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
# POSTGRES_DB=oh_my_paper
# DEPLOY_DATABASE_URL=postgresql://paper:REPLACE_WITH_A_RANDOM_PASSWORD@db:5432/oh_my_paper
# APP_VERSION=v2.0.0
