DATABASE_URL=postgresql://oh_my_paper:REPLACE_ME@127.0.0.1:5432/oh_my_paper
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Web 和 Worker 使用同一份至少 32 字符的随机秘密；部署后不要替换，否则已有 AI 密钥无法解密。
PROVIDER_KEY_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
STORAGE_ROOT=./storage
TEMP_ROOT=./tmp
PDFTOPPM_PATH=/usr/bin/pdftoppm
PDFINFO_PATH=/usr/bin/pdfinfo
# Linux 本地 Python 沙箱：需安装 Bubblewrap 并启用非特权用户命名空间。
BWRAP_PATH=/usr/bin/bwrap
# 本地可设为 .venv；Docker 镜像已预装 Pillow，使用 /opt/python-sandbox。
# PYTHON_SANDBOX_VENV=.venv
# PDF / Word 导出需要 Chromium 和中文字体；未设置时自动查找系统浏览器。
# EXPORT_CHROMIUM_PATH=/usr/bin/chromium
# Web 和 Worker 必须使用相同的队列 schema；测试环境可独立隔离。
QUEUE_SCHEMA=pgboss
WORKER_CONCURRENCY=2
