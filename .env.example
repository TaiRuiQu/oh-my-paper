DATABASE_URL=postgresql://oh_my_paper:REPLACE_ME@127.0.0.1:5432/oh_my_paper
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Web 和 Worker 使用同一份至少 32 字符的随机秘密；部署后不要替换，否则已有 AI 密钥无法解密。
PROVIDER_KEY_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
STORAGE_ROOT=./storage
TEMP_ROOT=./tmp
PDFTOPPM_PATH=/usr/bin/pdftoppm
PDFTOTEXT_PATH=/usr/bin/pdftotext
PDFINFO_PATH=/usr/bin/pdfinfo
# Optional but recommended for reliable photographed-page orientation (needs osd data).
# TESSERACT_PATH=/usr/bin/tesseract
# TESSERACT_DATA_PATH=/usr/share/tesseract-ocr/5/tessdata
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
PYTHON_PATH=.venv/bin/python
WORKER_CONCURRENCY=2
