DATABASE_URL=postgresql://oh_my_paper:REPLACE_ME@127.0.0.1:5432/oh_my_paper
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# AI provider keys are encrypted with this persistent secret.
PROVIDER_KEY_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Qdrant is used for question semantic search; keyword search does not require it.
# Local development: start Qdrant separately and use its HTTP endpoint.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=REPLACE_WITH_A_RANDOM_QDRANT_KEY
# Optional: isolate collections when sharing a Qdrant server across deployments.
# QDRANT_COLLECTION_PREFIX=oh_my_paper_questions
STORAGE_ROOT=./storage
# 小纸 Pi Durable: worker calls authenticated website APIs. Compose sets http://web:3000.
# XIAOZHI_WEBSITE_URL=http://127.0.0.1:3000
# Optional extra trusted skill packages, alongside skills/xiaozhi/<name>/SKILL.md.
# XIAOZHI_SKILLS_DIR=/data/xiaozhi-skills
# Conservative fallback context window for custom models; lower for smaller models.
# XIAOZHI_CONTEXT_WINDOW=65536
TEMP_ROOT=./tmp
# Experimental AI progress encoding over SSE: json (default) or protobuf.
# Runtime setting; no frontend rebuild is required. Other APIs keep using JSON.
# AI_PROGRESS_FORMAT=protobuf
# Optional: defaults to .venv/bin/python if present, otherwise python3.
# CARD_SCAN_PYTHON=/path/to/python
# Agent Python/shell tools require Linux, bubblewrap, util-linux and this Python venv.
# Defaults to .venv locally; the AI Worker image sets /opt/python-sandbox.
# PYTHON_SANDBOX_VENV=/path/to/python-venv
# BWRAP_PATH=/usr/bin/bwrap
# Docker Compose deployment (not used by a local pnpm dev server):
# APP_DOMAIN=paper.example.com
# POSTGRES_USER=paper
# POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
# POSTGRES_DB=oh_my_paper
# DEPLOY_DATABASE_URL=postgresql://paper:REPLACE_WITH_A_RANDOM_PASSWORD@db:5432/oh_my_paper
# Complete release selector: latest, sha-<full 40-character commit SHA>, or release tag.
# APP_VERSION=latest
# Source builds only: set to the full git rev-parse HEAD value for the footer.
# Published images already include their source commit at build time.
# APP_COMMIT_SHA=
