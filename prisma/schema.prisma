generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceKind {
  PERSONAL
  TEACHING
}

enum WorkspaceRole {
  OWNER
  TEACHER
  STUDENT
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("USER")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      Session[]
  accounts      Account[]
  workspaces    Workspace[]
  memberships   WorkspaceMember[]
  examTasks     ExamTask[]

  @@map("users")
}

model AiProvider {
  id                String   @id @default(uuid())
  name              String
  apiType           String
  baseURL           String
  model             String
  promptPreset      String   @default("openai")
  encryptedApiKey   String
  structuredOutputs Boolean  @default(false)
  maxOutputTokens   Int      @default(16000)
  timeoutSeconds    Int      @default(240)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  settings          AiSetting[]

  @@map("ai_providers")
}

model AiSetting {
  id         String      @id
  providerId String?
  provider   AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@map("ai_settings")
}

enum ExamTaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model ExamTask {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  status           ExamTaskStatus @default(QUEUED)
  inputFiles       String[]
  providerSnapshot Json
  model            String
  jobId            String         @unique
  attempt          String?
  outputKey        String?
  page             Int            @default(0)
  totalPages       Int            @default(0)
  phase            String         @default("queued")
  error            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  gradeTasks       GradeTask[]
  autoGrade        Boolean        @default(false)
  studentId        String?
  student          StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  batchId          String?
  batch            GradeBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("exam_tasks")
}

model WorkerHeartbeat {
  id        String   @id
  updatedAt DateTime @default(now())
  @@map("worker_heartbeats")
}

model Classroom {
  id        String @id @default(uuid())
  ownerId   String
  name      String
  students  StudentProfile[]
  batches   GradeBatch[]
  createdAt DateTime @default(now())
  @@index([ownerId])
  @@map("classrooms")
}

model StudentProfile {
  id          String @id @default(uuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  number      String
  accountId   String?
  exams       ExamTask[]
  @@unique([classroomId, number])
  @@index([accountId])
  @@map("student_profiles")
}

model GradeBatch {
  id          String @id @default(uuid())
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  name        String
  exams       ExamTask[]
  createdAt   DateTime @default(now())
  @@map("grade_batches")
}

model LearningTag {
  id        String @id @default(uuid())
  userId    String
  entryKey  String
  topicId   String
  @@unique([userId, entryKey])
  @@map("learning_tags")
}

model PracticeSession {
  id          String @id @default(uuid())
  userId      String
  gradeTaskId String
  questionId  String
  entryKey    String
  mode        String
  status      ExamTaskStatus @default(QUEUED)
  jobId       String @unique
  attempt     String?
  input       Json
  content     Json?
  answers     Json?
  result      Json?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, createdAt])
  @@map("practice_sessions")
}

model GradeTask {
  id               String         @id @default(uuid())
  examTaskId       String
  examTask         ExamTask       @relation(fields: [examTaskId], references: [id], onDelete: Cascade)
  examOutputKey    String
  status           ExamTaskStatus @default(QUEUED)
  input            Json
  providerSnapshot Json
  model            String
  promptVersion    String
  jobId            String         @unique
  attempt          String?
  progress         Int            @default(0)
  total            Int
  phase            String         @default("queued")
  result           Json?
  error            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([examTaskId, createdAt])
  @@map("grade_tasks")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  kind      WorkspaceKind     @default(PERSONAL)
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   WorkspaceMember[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([ownerId, kind])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(STUDENT)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}
