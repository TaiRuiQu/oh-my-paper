generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  role String @default("STUDENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  questions Question[]
  papers Paper[]
  classrooms Classroom[]
  studentRecords ClassroomStudent[]
  assessments Assessment[]
  templates CardTemplate[]
  submissions ScanSubmission[]
  reviews Review[]
  @@map("users")
}

model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("sessions")
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verifications")
}

model AiProvider {
  id String @id @default(uuid())
  name String
  apiType String
  baseURL String
  encryptedApiKey String
  structuredOutputs Boolean @default(true)
  maxOutputTokens Int @default(16384)
  timeoutSeconds Int @default(240)
  maxConcurrency Int @default(3)
  models AiModel[]
  @@map("ai_providers")
}
model AiModel {
  id String @id @default(uuid())
  providerId String
  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name String
  displayName String @default("")
  reasoningEfforts String[]
  settings AiSetting[]
  isPublic Boolean @default(false)
  creditMultiplier Decimal @default(1) @db.Decimal(12, 4)
  @@unique([providerId, name])
  @@map("ai_models")
}
model AiSetting {
  id String @id
  modelId String?
  model AiModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  reasoningEffort String @default("default")
  @@map("ai_settings")
}

model Question {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type String
  subject String
  grade String
  difficulty Float
  knowledgeTags String[]
  content Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, subject])
  @@map("questions")
}
model Paper {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  kind String
  subject String
  grade String
  instructions String @db.Text
  layout Json
  items PaperItem[]
  assessmentPapers AssessmentPaper[]
  templates CardTemplate[]
  submissions ScanSubmission[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId])
  @@map("papers")
}
model PaperItem {
  id String @id @default(uuid())
  paperId String
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  questionId String
  position Int
  score Float
  section String
  snapshot Json
  @@unique([paperId, position])
  @@map("paper_items")
}
model Classroom {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  grade String
  reviewerIds String[] @default([])
  students ClassroomStudent[]
  @@index([ownerId])
  @@map("classrooms")
}
model ClassroomStudent {
  id String @id @default(uuid())
  classroomId String
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentNumber String
  name String
  submissions ScanSubmission[]
  @@unique([classroomId, studentNumber])
  @@unique([classroomId, userId])
  @@index([userId])
  @@map("classroom_students")
}
model Assessment {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name String
  kind String
  classroomIds String[]
  studentIds String[] @default([])
  papers AssessmentPaper[]
  published Boolean @default(false)
  submissions ScanSubmission[]
  createdAt DateTime @default(now())
  @@index([ownerId])
  @@map("assessments")
}
model AssessmentPaper {
  assessmentId String
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  paperId String
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Restrict)
  subject String
  gradingMode String
  arbitrationThreshold Float
  conversion Json
  @@id([assessmentId, paperId])
  @@map("assessment_papers")
}
model CardTemplate {
  id String @id @default(uuid())
  ownerId String?
  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  paperId String?
  paper Paper? @relation(fields: [paperId], references: [id], onDelete: Cascade)
  name String
  subject String
  preset Boolean @default(false)
  layout Json
  submissions ScanSubmission[]
  @@index([ownerId])
  @@map("card_templates")
}
model ScanSubmission {
  id String @id @default(uuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  paperId String
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Restrict)
  studentId String
  student ClassroomStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)
  templateId String?
  template CardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  kind String
  status String @default("PENDING")
  sourceFiles String[]
  answers Json
  alignment Json?
  reviews Review[]
  createdAt DateTime @default(now())
  @@unique([assessmentId, paperId, studentId])
  @@index([ownerId])
  @@map("scan_submissions")
}
model Review {
  id String @id @default(uuid())
  submissionId String
  submission ScanSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  itemId String
  reviewerId String
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  round String
  score Float
  feedback String @db.Text
  source String @default("HUMAN")
  aiJobId String?
  partScores Json @default("[]")
  createdAt DateTime @default(now())
  @@unique([submissionId, itemId, round])
  @@index([reviewerId])
  @@map("reviews")
}

model PlatformAsset {
  id String @id @default(uuid())
  ownerId String
  name String
  contentType String
  path String
  createdAt DateTime @default(now())
  @@index([ownerId])
  @@map("platform_assets")
}


model AiJob {
  id String @id @default(uuid())
  userId String
  kind String
  modelId String
  status String @default("QUEUED")
  input Json
  result Json?
  events Json @default("[]")
  error String?
  attempts Int @default(0)
  workerId String?
  heartbeatAt DateTime?
  createdAt DateTime @default(now())
  startedAt DateTime?
  finishedAt DateTime?
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("ai_jobs")
}
