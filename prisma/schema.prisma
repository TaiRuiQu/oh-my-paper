generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String               @id
  name          String
  email         String               @unique
  emailVerified Boolean              @default(false)
  image         String?
  role          String               @default("USER")
  credits       Decimal              @default(100) @db.Decimal(24, 8)
  aiSelections  UserAiSelection[]
  creditUsage   CreditUsage[]
  creditGrants  CreditGrant[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  sessions      Session[]
  accounts      Account[]
  exams         Exam[]
  examTasks     ExamTask[]
  workflows     GradingWorkflow[]
  submissions   Submission[]
  cardTemplates AnswerCardTemplate[]
  cardBatches   AnswerCardBatch[]

  @@map("users")
}

model Exam {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  totalScore  Float?
  revision    Int             @default(0)
  sections    ExamSection[]
  questions   ExamQuestion[]
  answer      ExamAnswer?
  submissions Submission[]
  task        ExamTask?
  agentTasks  ExamAgentTask[]

  @@index([userId])
  @@map("exams")
}

model ExamSection {
  id          String         @id @default(uuid())
  examId      String
  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  position    Int
  number      String
  title       String
  description String         @db.Text
  score       Float?
  questions   ExamQuestion[]

  @@unique([examId, position])
  @@unique([examId, number])
  @@unique([id, examId])
  @@map("exam_sections")
}

model ExamQuestion {
  id           String             @id @default(uuid())
  examId       String
  exam         Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  position     Int
  sectionId    String
  section      ExamSection        @relation(fields: [sectionId, examId], references: [id, examId], onDelete: Cascade)
  number       Int
  description  String             @db.Text
  materials    Json
  score        Float?
  subquestions Json               @default("[]")
  answer       QuestionAnswer?
  submissions  SubmissionAnswer[]

  @@unique([examId, position])
  @@unique([id, examId])
  @@map("exam_questions")
}

model ExamAnswer {
  examId    String           @id
  exam      Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions QuestionAnswer[]

  @@map("exam_answers")
}

model QuestionAnswer {
  questionId      String       @id
  examId          String
  examAnswer      ExamAnswer   @relation(fields: [examId], references: [examId], onDelete: Cascade)
  question        ExamQuestion @relation(fields: [questionId, examId], references: [id, examId], onDelete: Cascade)
  solution        String       @db.Text
  gradingCriteria String       @db.Text

  @@unique([questionId, examId])
  @@map("question_answers")
}

model Submission {
  id          String             @id @default(uuid())
  examId      String
  exam        Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String?
  student     User?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  answers     SubmissionAnswer[]
  agentTask   ExamAgentTask?
  cardStudent AnswerCardStudent?

  @@unique([id, examId])
  @@index([examId])
  @@index([studentId])
  @@map("submissions")
}

model SubmissionAnswer {
  submissionId String
  examId       String
  questionId   String
  submission   Submission   @relation(fields: [submissionId, examId], references: [id, examId], onDelete: Cascade)
  question     ExamQuestion @relation(fields: [questionId, examId], references: [id, examId], onDelete: Cascade)
  answer       String       @db.Text
  feedback     String       @default("") @db.Text
  correct      Boolean?
  score        Float?

  @@id([submissionId, questionId])
  @@map("submission_answers")
}

model AiProvider {
  id                String    @id @default(uuid())
  name              String
  apiType           String
  baseURL           String
  encryptedApiKey   String
  structuredOutputs Boolean   @default(true)
  maxOutputTokens   Int       @default(16000)
  timeoutSeconds    Int       @default(240)
  maxConcurrency    Int       @default(3)
  models            AiModel[]

  @@map("ai_providers")
}

model AiModel {
  id               String            @id @default(uuid())
  providerId       String
  provider         AiProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name             String
  displayName      String            @default("")
  reasoningEfforts String[]
  settings         AiSetting[]
  isPublic         Boolean           @default(false)
  creditMultiplier Decimal           @default(1) @db.Decimal(12, 4)
  userSelections   UserAiSelection[]

  @@unique([providerId, name])
  @@map("ai_models")
}

model AiSetting {
  id              String   @id
  modelId         String?
  model           AiModel? @relation(fields: [modelId], references: [id], onDelete: SetNull)
  reasoningEffort String   @default("default")

  @@map("ai_settings")
}

enum ExamTaskStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

model ExamTask {
  id               String               @id @default(uuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId           String?              @unique
  exam             Exam?                @relation(fields: [examId], references: [id], onDelete: SetNull)
  name             String
  status           ExamTaskStatus       @default(QUEUED)
  totalQuestions   Int?
  parsedQuestions  Int                  @default(0)
  inputFiles       String[]
  creditsSpent     Decimal              @default(0) @db.Decimal(24, 8)
  providerSnapshot Json
  jobId            String               @unique
  attempt          String?
  outputKey        String?
  errorCode        String?
  error            String?
  createdAt        DateTime             @default(now())
  deletedAt        DateTime?
  workflows        GradingWorkflow[]
  cardTemplates    AnswerCardTemplate[]

  @@index([userId, createdAt])
  @@map("exam_tasks")
}

model WorkerHeartbeat {
  id        String   @id
  updatedAt DateTime @default(now())

  @@map("worker_heartbeats")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

enum ExamAgentKind {
  ANSWER
  GRADING
}

model ExamAgentTask {
  id               String         @id @default(uuid())
  examId           String
  examRevision     Int            @default(0)
  exam             Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  kind             ExamAgentKind
  name             String
  status           ExamTaskStatus @default(QUEUED)
  totalQuestions   Int?
  inputFiles       String[]
  creditsSpent     Decimal        @default(0) @db.Decimal(24, 8)
  providerSnapshot Json
  reference        Json           @default("[]")
  result           Json           @default("{\"questions\":[]}")
  jobId            String         @unique
  attempt          String?
  submissionId     String?        @unique
  submission       Submission?    @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  errorCode        String?
  error            String?
  createdAt        DateTime       @default(now())

  @@index([examId, createdAt])
  @@map("exam_agent_tasks")
}

model GradingWorkflow {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId       String
  source         ExamTask       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  kind           String
  name           String
  status         ExamTaskStatus @default(QUEUED)
  answerTaskId   String?
  gradingTaskId  String?
  inputFiles     String[]
  referenceFiles String[]       @default([])
  modelSnapshots Json           @default("{}")
  billAnswer     Boolean        @default(false)
  jobId          String         @unique
  errorCode      String?
  error          String?
  createdAt      DateTime       @default(now())

  @@index([userId, createdAt])
  @@map("grading_workflows")
}

model UserAiSelection {
  userId          String
  purpose         String
  modelId         String
  reasoningEffort String?
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  model           AiModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([userId, purpose])
  @@map("user_ai_selections")
}

model CreditUsage {
  id               String   @id
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId           String
  taskKind         String
  attempt          String
  providerId       String
  providerName     String
  modelId          String?
  model            String
  displayName      String   @default("")
  creditMultiplier Decimal  @db.Decimal(12, 4)
  inputTokens      Int
  cachedTokens     Int
  outputTokens     Int
  credits          Decimal  @db.Decimal(24, 8)
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskKind, taskId])
  @@map("credit_usage")
}

model CreditGrant {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  amount    Decimal  @db.Decimal(24, 8)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("credit_grants")
}

model AnswerCardTemplate {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId         String
  source           ExamTask          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  examRevision     Int
  name             String
  status           ExamTaskStatus    @default(QUEUED)
  inputFiles       String[]
  providerSnapshot Json
  regions          Json              @default("[]")
  pageCount        Int               @default(0)
  jobId            String            @unique
  attempt          String?
  outputKey        String?
  creditsSpent     Decimal           @default(0) @db.Decimal(24, 8)
  error            String?
  errorCode        String?
  createdAt        DateTime          @default(now())
  batches          AnswerCardBatch[]

  @@index([userId, createdAt])
  @@map("answer_card_templates")
}

model AnswerCardBatch {
  id               String              @id @default(uuid())
  userId           String
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId       String
  template         AnswerCardTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name             String
  status           ExamTaskStatus      @default(QUEUED)
  examSnapshot     Json
  reference        Json
  providerSnapshot Json
  jobId            String              @unique
  attempt          String?
  creditsSpent     Decimal             @default(0) @db.Decimal(24, 8)
  error            String?
  errorCode        String?
  createdAt        DateTime            @default(now())
  students         AnswerCardStudent[]

  @@index([userId, createdAt])
  @@map("answer_card_batches")
}

model AnswerCardStudent {
  id           String          @id @default(uuid())
  batchId      String
  batch        AnswerCardBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  position     Int
  name         String
  inputFiles   String[]
  status       ExamTaskStatus  @default(QUEUED)
  result       Json            @default("{\"questions\":[]}")
  submissionId String?         @unique
  submission   Submission?     @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  error        String?

  @@unique([batchId, position])
  @@map("answer_card_students")
}
