{
  "name": "oh-my-paper",
  "version": "2.0.3",
  "private": true,
  "description": "K12 题库、组卷、考试阅卷与学情分析平台",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.x"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/openai": "4.0.91",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.104.1",
    "ai": "7.0.137",
    "better-auth": "1.7.7",
    "bwip-js": "4.11.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "docx": "9.10.0",
    "dotenv": "18.0.7",
    "eventsource-parser": "4.1.2",
    "exceljs": "4.4.0",
    "katex": "0.19.0",
    "lucide-react": "1.55.0",
    "mathml2omml": "0.5.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "unified": "11.0.5",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vercel/nft": "1.11.0",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "jszip": "3.10.2",
    "micromark-util-types": "2.0.3",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "db:start": "bash scripts/postgres.sh start",
    "db:stop": "bash scripts/postgres.sh stop",
    "db:status": "bash scripts/postgres.sh status",
    "dev": "pnpm run dev:all",
    "dev:web": "node scripts/prepare-print-fonts.mjs && next dev",
    "build": "pnpm run db:generate && node scripts/prepare-print-fonts.mjs && next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --conditions=react-server --import tsx scripts/test-platform.ts",
    "test:permissions": "node --conditions=react-server --import tsx scripts/test-permissions.ts",
    "test:account-import": "node --conditions=react-server --import tsx scripts/test-account-import.ts",
    "test:record-names": "node --conditions=react-server --import tsx scripts/test-record-names.ts",
    "test:semantic-search": "node --conditions=react-server --import tsx scripts/test-semantic-search.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:setup": "pnpm run db:start && pnpm run db:generate && pnpm run db:deploy",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "test:scan": "node --conditions=react-server --import tsx scripts/test-scans.ts",
    "dev:ai-worker": "node --conditions=react-server --import tsx --watch scripts/ai-worker.ts",
    "dev:all": "concurrently --kill-others --names web,ai-worker \"pnpm run dev:web\" \"pnpm run dev:ai-worker\"",
    "build:ai-worker": "pnpm run db:generate && node scripts/build-ai-worker.mjs",
    "start:ai-worker": "node --conditions=react-server build/ai-worker/worker.mjs",
    "test:ai-jobs": "node --conditions=react-server --import tsx scripts/test-ai-jobs.ts",
    "test:ai-domain": "node --conditions=react-server --import tsx scripts/test-ai-domain.ts",
    "test:http": "node --conditions=react-server --import tsx scripts/test-platform-http.ts",
    "test:ai-live": "node --conditions=react-server --import tsx scripts/test-ai-live.ts",
    "test:production": "node --conditions=react-server --import tsx scripts/test-production.ts",
    "test:ai-mixed-live": "node --conditions=react-server --import tsx scripts/test-ai-mixed-live.ts",
    "test:sandbox": "node --conditions=react-server --import tsx scripts/test-sandbox.ts"
  }
}
