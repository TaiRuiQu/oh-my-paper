{
  "name": "oh-my-paper",
  "version": "0.0.0",
  "private": true,
  "description": "K12 试卷解析、批改与错题练习",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.x"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.104.1",
    "ai": "7.0.137",
    "better-auth": "1.7.7",
    "busboy": "1.6.0",
    "dotenv": "18.0.7",
    "file-type": "22.1.1",
    "mathjax": "4.1.3",
    "next": "16.4.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/busboy": "1.5.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.29",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "db:start": "bash scripts/postgres.sh start",
    "db:stop": "bash scripts/postgres.sh stop",
    "db:status": "bash scripts/postgres.sh status",
    "dev": "next dev",
    "dev:worker": "node --conditions=react-server --import tsx --watch worker/index.ts",
    "dev:all": "concurrently --kill-others --names web,worker \"pnpm run dev\" \"pnpm run dev:worker\"",
    "build": "pnpm run db:generate && next build --webpack",
    "start": "next start",
    "start:worker": "node --conditions=react-server --import tsx worker/index.ts --production",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --conditions=react-server --import tsx scripts/test-integration.ts",
    "test:queue": "node --conditions=react-server --import tsx scripts/test-queue.ts",
    "test:exam-web": "node --conditions=react-server --import tsx scripts/test-exam-web.ts",
    "test:grading-web": "node --conditions=react-server --import tsx scripts/test-grading-web.ts",
    "parse:exam": "node --conditions=react-server --import tsx scripts/parse-exam.ts",
    "eval:exams": "node --conditions=react-server --import tsx scripts/evaluate-exams.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:setup": "pnpm run db:start && pnpm run db:generate && pnpm run db:deploy"
  }
}
