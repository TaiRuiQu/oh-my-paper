{
  "name": "oh-my-paper",
  "version": "0.1.4",
  "private": true,
  "description": "试卷上传与结构化解析",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.x"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/google": "4.0.93",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.104.1",
    "ai": "7.0.137",
    "better-auth": "1.7.7",
    "busboy": "1.6.0",
    "docx": "9.10.0",
    "dotenv": "18.0.7",
    "file-type": "22.1.1",
    "katex": "0.19.0",
    "lucide-react": "1.55.0",
    "mathml2omml": "0.5.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "puppeteer-core": "25.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "unified": "11.0.5",
    "xml-js": "1.6.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/busboy": "1.5.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "jszip": "3.10.1",
    "micromark-util-types": "2.0.3",
    "postcss": "8.5.29",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "db:start": "bash scripts/postgres.sh start",
    "db:stop": "bash scripts/postgres.sh stop",
    "db:status": "bash scripts/postgres.sh status",
    "dev": "pnpm run dev:all",
    "dev:web": "next dev",
    "dev:worker": "node --conditions=react-server --import tsx --watch worker/index.ts",
    "dev:all": "concurrently --kill-others --names web,worker \"pnpm run dev:web\" \"pnpm run dev:worker\"",
    "build": "pnpm run db:generate && next build --webpack",
    "start": "next start",
    "start:worker": "node --conditions=react-server --import tsx worker/index.ts --production",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --conditions=react-server --import tsx scripts/test-integration.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:setup": "pnpm run db:start && pnpm run db:generate && pnpm run db:deploy",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test"
  }
}
