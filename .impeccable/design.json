  ],
  "narrative": {
    "northStar": "Operate · 安静的教学工作台",
    "overview": "Oh My Paper 面向备课、组织考试和逐题评阅的教师，以及查看学习反馈的学生。浅灰工作区、白色纸面和克制的蓝色操作建立稳定的信息层级；紧凑表格、中文无衬线文字和原生表单让教学内容成为界面中心。\n\n视觉表达来自可核对的题目、作答、分值和状态。工作台用连续的内联面板组织操作，细线划分信息，复杂资料与执行记录使用原生折叠。桌面保留导航，手机转为抽屉和单列内容。",
    "keyCharacteristics": [
      "浅灰工作区、白色面板与蓝色主要操作。",
      "自托管中文字体、紧凑标题和对齐的表格数值。",
      "内联编辑、明确动作名称与可恢复的状态反馈。",
      "桌面持续导航、手机焦点受控抽屉和局部表格滚动。"
    ],
    "rules": [
      {
        "name": "The Semantic State Rule",
        "body": "状态颜色必须与明确的中文状态或错误说明一起出现；保留排队、处理中、完成和失败的实际区别。",
        "section": "colors"
      },
      {
        "name": "The Numeric Evidence Rule",
        "body": "表格与分数使用等宽数字排布（tabular numerals），保持得分、满分和排名的阅读顺序；未评分处显示「待评分」或破折号。",
        "section": "typography"
      },
      {
        "name": "The Local Overflow Rule",
        "body": "管理表格保留内容所需宽度（最小 680px），在所属区域滚动，页面列本身必须可收缩。表格容器以对应内容命名的 region 保持键盘可聚焦与滚动；沿用全局可见焦点。数学公式、Markdown 表格与代码块也在各自容器内横向滚动；手机工具栏换行，题目操作与分值保持邻近。",
        "section": "layout"
      },
      {
        "name": "The Visible Focus Rule",
        "body": "键盘焦点使用清晰的浅蓝外轮廓（3px，偏移 3px），覆盖链接、按钮和原生字段；跳转到主要内容的链接在聚焦时显示。",
        "section": "elevation & depth"
      }
    ],
    "dos": [
      "**Do** 使用浅灰工作区、白纸面与蓝色主要操作，并保持紧凑表格和一致字段。",
      "**Do** 保留中文动作名称、题目编号、配图、选项、子问分值和实际作答的层级。",
      "**Do** 用清楚的状态文字、错误说明和重试动作承载后台工作的反馈。",
      "**Do** 保留可见焦点、抽屉焦点管理、内联编辑与减少动态效果行为。",
      "**Do** 让筛选范围同时决定成绩、知识点、科目汇总和错题数量。"
    ],
    "donts": [
      "**Don't** 用装饰性指标卡、插图或渐变取代教学内容与真实表格。",
      "**Don't** 把等待动画当成任务百分比或准确率证据。",
      "**Don't** 隐藏未评分、扫描不确定信息或失败任务的恢复路径。",
      "**Don't** 让长表格扩张整个页面，或让手机用户只能使用指针创建答题区域。",
      "**Don't** 把教师管理入口和他人的作答加入学生的「我的学习」视图。"
    ]
  }
}
